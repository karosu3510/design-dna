{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Vortex Gallery Design System",
  "version": "1.0.0",
  "description": "Deep-space black canvas with warm vintage poster accents. Cylindrical motion language, momentum-driven scroll, WebGL-grade typography. Built for immersive media galleries, archive viewers, and cinematic landing pages.",
  "color": {
    "void":     { "$value": "#0a0a0a", "$type": "color", "$description": "Canvas / deep space background" },
    "depth":    { "$value": "#101010", "$type": "color", "$description": "Card surface (one tier above void)" },
    "shell":    { "$value": "#161616", "$type": "color", "$description": "Panel surface" },
    "soft":     { "$value": "#1f1f1f", "$type": "color", "$description": "Hover / secondary surface" },
    "line":     { "$value": "rgba(255,255,255,0.08)", "$type": "color", "$description": "Hairline border" },
    "line-2":   { "$value": "rgba(255,255,255,0.14)", "$type": "color", "$description": "Active hairline" },
    "ink":      { "$value": "#fafafa", "$type": "color", "$description": "Primary text" },
    "ink-2":    { "$value": "rgba(255,255,255,0.62)", "$type": "color", "$description": "Secondary text" },
    "ink-3":    { "$value": "rgba(255,255,255,0.42)", "$type": "color", "$description": "Tertiary / caption" },
    "ink-4":    { "$value": "rgba(255,255,255,0.22)", "$type": "color", "$description": "Disabled / decorative" },
    "ember":    { "$value": "#ff7a3d", "$type": "color", "$description": "Warm vintage poster accent — reserve for active state" },
    "ember-soft": { "$value": "rgba(255,122,61,0.18)", "$type": "color", "$description": "Ember glow / hover pad" },
    "sun":      { "$value": "#ffd24a", "$type": "color", "$description": "Highlight (numerals, badges) — secondary accent" },
    "ocean":    { "$value": "#3a78ff", "$type": "color", "$description": "Link / nav underline — used sparingly" }
  },
  "font": {
    "family": {
      "sans": { "$value": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', 'SF Mono', ui-monospace, Menlo, monospace", "$type": "fontFamily" },
      "display": { "$value": "'Inter Tight', 'Inter', -apple-system, sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "hero":    { "$value": "84px", "$type": "dimension" },
      "display": { "$value": "56px", "$type": "dimension" },
      "h1":      { "$value": "36px", "$type": "dimension" },
      "h2":      { "$value": "22px", "$type": "dimension" },
      "lg":      { "$value": "17px", "$type": "dimension" },
      "md":      { "$value": "15px", "$type": "dimension" },
      "base":    { "$value": "13.5px", "$type": "dimension" },
      "sm":      { "$value": "12px", "$type": "dimension" },
      "cap":     { "$value": "10px", "$type": "dimension" },
      "mini":    { "$value": "9px", "$type": "dimension" }
    },
    "tracking": {
      "tight": { "$value": "-0.04em" },
      "snug":  { "$value": "-0.02em" },
      "base":  { "$value": "-0.005em" },
      "cap":   { "$value": "0.18em" },
      "wide":  { "$value": "0.24em" }
    },
    "weight": {
      "extralight": { "$value": "200" },
      "light":      { "$value": "300" },
      "regular":    { "$value": "400" },
      "medium":     { "$value": "500" },
      "semibold":   { "$value": "600" }
    }
  },
  "spacing": {
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "7": { "$value": "32px", "$type": "dimension" },
    "8": { "$value": "48px", "$type": "dimension" },
    "9": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "shell": { "$value": "20px", "$type": "dimension" },
    "panel": { "$value": "14px", "$type": "dimension" },
    "card":  { "$value": "10px", "$type": "dimension" },
    "tile":  { "$value": "6px",  "$type": "dimension" },
    "pill":  { "$value": "999px","$type": "dimension" }
  },
  "shadow": {
    "depth":  { "$value": "0 1px 0 rgba(255,255,255,0.04) inset, 0 24px 48px rgba(0,0,0,0.6)" },
    "glow":   { "$value": "0 0 0 1px rgba(255,122,61,0.4), 0 0 36px rgba(255,122,61,0.18)" },
    "inset":  { "$value": "inset 0 0 0 1px rgba(255,255,255,0.06)" }
  },
  "motion": {
    "ease": {
      "vortex": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "soft":   { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "snap":   { "$value": "cubic-bezier(0.22, 0.61, 0.36, 1)" }
    },
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "260ms" },
      "slow": { "$value": "640ms" }
    },
    "lerp": {
      "snappy":   { "$value": "0.18", "$description": "Cursor / hover follow" },
      "balanced": { "$value": "0.10", "$description": "Default scroll smoothing" },
      "inertial": { "$value": "0.05", "$description": "Heavy momentum (vortex camera)" }
    }
  }
}
