{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Glyph OS Design System",
  "version": "1.0.0",
  "description": "Pixel desktop OS. Pure black canvas, VT323 numerals, single red dot for live, single lime for charge. Inspired by Nothing OS and Teenage Engineering's TM-1.",
  "color": {
    "bg":      { "$value": "#000000", "$type": "color", "$description": "Page canvas — pure black, never #111 or grey" },
    "shell":   { "$value": "#0e0e0e", "$type": "color", "$description": "Deepest panel" },
    "card":    { "$value": "#141414", "$type": "color", "$description": "Default module card" },
    "card-2":  { "$value": "#1b1b1b", "$type": "color", "$description": "Secondary fill (rows, chips)" },
    "line":    { "$value": "#2a2a2a", "$type": "color", "$description": "Hairline border" },
    "line-2":  { "$value": "#3a3a3a", "$type": "color", "$description": "Slightly stronger hairline" },
    "ink":     { "$value": "#ffffff", "$type": "color", "$description": "Primary text + numerals" },
    "ink-2":   { "$value": "#c5c5c5", "$type": "color" },
    "ink-3":   { "$value": "#7c7c7c", "$type": "color" },
    "ink-4":   { "$value": "#4a4a4a", "$type": "color" },
    "rec":     { "$value": "#ff3b30", "$type": "color", "$description": "Only red — live / recording / error" },
    "ok":      { "$value": "#c8ff5e", "$type": "color", "$description": "Only lime — battery OK / charging" },
    "inv-bg":  { "$value": "#fafaf6", "$type": "color", "$description": "Inverse card background (used at most once per layout)" },
    "inv-ink": { "$value": "#0a0a0a", "$type": "color" }
  },
  "font": {
    "family": {
      "pixel": { "$value": "VT323, 'Press Start 2P', ui-monospace, Menlo, monospace", "$type": "fontFamily" },
      "sans":  { "$value": "Inter, 'Helvetica Neue', Arial, sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "display": { "$value": "118px", "$type": "dimension" },
      "h1":      { "$value": "62px",  "$type": "dimension" },
      "h2":      { "$value": "46px",  "$type": "dimension" },
      "num":     { "$value": "30px",  "$type": "dimension" },
      "md":      { "$value": "22px",  "$type": "dimension" },
      "base":    { "$value": "14px",  "$type": "dimension" },
      "sm":      { "$value": "13px",  "$type": "dimension" },
      "cap":     { "$value": "12px",  "$type": "dimension" },
      "mini":    { "$value": "11px",  "$type": "dimension" }
    },
    "tracking": {
      "tight": { "$value": "0" },
      "cap":   { "$value": "0.16em" },
      "cap-2": { "$value": "0.18em" }
    }
  },
  "spacing": {
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" }
  },
  "radius": {
    "shell": { "$value": "22px",  "$type": "dimension" },
    "card":  { "$value": "18px",  "$type": "dimension" },
    "tile":  { "$value": "10px",  "$type": "dimension" },
    "chip":  { "$value": "8px",   "$type": "dimension" },
    "pill":  { "$value": "999px", "$type": "dimension" }
  },
  "motion": {
    "ease": {
      "step": { "$value": "steps(1, end)", "$description": "Pixel-perfect frame swap, no tween" },
      "out":  { "$value": "cubic-bezier(0.22, 0.61, 0.36, 1)" }
    },
    "duration": {
      "tick": { "$value": "60ms", "$description": "One pixel frame" },
      "fast": { "$value": "120ms" },
      "base": { "$value": "240ms" }
    }
  }
}
